# Required by dsh plugin installs: several peer packages on the peer chain are
# not published publicly, and pnpm's default auto-install-peers=true would try
# to fetch the whole peer graph and fail with 404.
auto-install-peers=false

# The plugin is installed by dsh (which forwards to pnpm) inside
# $DSH_HOME/profiles/<name>; keep the install layout predictable.
node-linker=hoisted
resolution-mode=highest
strict-peer-dependencies=false
